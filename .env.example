# Copy this file to ".env" and fill in real values. NEVER commit the real .env.

# Port the server listens on
PORT=3000

# Secret used to sign session cookies. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# api-football (v3.football.api-sports.io) key. Keep this server-side only.
# Get it from your api-football.com dashboard.
API_FOOTBALL_KEY=

# When true, the app reads fixtures/standings/players from seed/*.json instead of
# calling the live API. Use this for local development (the API host may be blocked).
USE_MOCK_DATA=true

# World Cup league id + season for api-football (World Cup is league 1).
WC_LEAGUE_ID=1
WC_SEASON=2026

# Bootstrap site admin (used by `npm run seed-admin`).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Admin
